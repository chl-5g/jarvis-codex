{
  "os": {
    "kind": "capability",
    "registry": "capabilities.json",
    "auth": "macos-tcc",
    "auditStream": "jarvis-events.jsonl"
  },
  "cipherpipe": {
    "kind": "agent-messaging",
    "enabledByDefault": false,
    "auth": "pairing-token",
    "auditStream": "conversation.jsonl"
  },
  "booking": {
    "kind": "platform-api",
    "enabledByDefault": false,
    "auth": "user-oauth-or-api-key",
    "requiresConfirmation": true,
    "auditStream": "jarvis-events.jsonl"
  },
  "rideHailing": {
    "kind": "platform-api",
    "enabledByDefault": false,
    "auth": "user-oauth-or-api-key",
    "requiresConfirmation": true,
    "auditStream": "jarvis-events.jsonl"
  },
  "calendar": {
    "kind": "platform-api",
    "enabledByDefault": false,
    "auth": "user-oauth-or-os-permission",
    "requiresConfirmation": false,
    "auditStream": "jarvis-events.jsonl"
  },
  "pdfspine": {
    "kind": "document-ocr",
    "enabledByDefault": true,
    "binaryEnv": "JARVIS_PDFSPINE_BIN",
    "auth": "workspace-file-access",
    "auditStream": "jarvis-events.jsonl"
  },
  "speaker_identity": {
    "kind": "local-speaker-verification-and-profiles",
    "enabledByDefault": true,
    "modelEnv": "JARVIS_SPEAKER_MODEL",
    "profileDirectory": "~/.config/jarvis/speakers",
    "authorizationProfile": "Allen",
    "auditStream": "jarvis-events.jsonl"
  }
}
